<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PassCraft.UI.Views"
                xmlns:constants="clr-namespace:PassCraft.Core.Constants;assembly=PassCraft.Core"
                x:Class="PassCraft.UI.Views.MainPage"
                Title="PassCraft">

    <views:BasePage.ToolbarItems>
        <ToolbarItem x:Name="ThemeToggleBtn"
                     IconImageSource="{AppThemeBinding Light=ic_theme_light.png, Dark=ic_theme_dark.png}" 
                     Order="Primary" 
                     Priority="0" 
                     Clicked="OnThemeToggleClicked" />

        <ToolbarItem IconImageSource="{AppThemeBinding Light=ic_history_light.png, Dark=ic_history_dark.png}" 
                     Order="Primary" 
                     Priority="1" 
                     Clicked="OnViewHistoryClicked" />
    </views:BasePage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10" HorizontalOptions="Center" WidthRequest="360">

            <Label Text="Password Generator" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5" />

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Editor Grid.Column="0" 
                    x:Name="PasswordEntry" 
                    IsReadOnly="True" 
                    FontFamily="Monospace" 
                    FontSize="16" 
                    AutoSize="TextChanges"
                    MinimumHeightRequest="60"
                    Placeholder="Tap to generate" />
                <ImageButton Grid.Column="1" 
                         x:Name="CopyBtn" 
                         Source="{AppThemeBinding Light=ic_copy_light.png, Dark=ic_copy_dark.png}" 
                         WidthRequest="45" 
                         HeightRequest="45"
                         Padding="10"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center" 
                         Clicked="OnCopyClicked" />
            </Grid>

            <Border Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1" Padding="10,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Password Length" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Grid.Column="1" 
                           Text="{Binding Source={x:Reference LengthSlider}, Path=Value, StringFormat='{0:F0}'}" 
                           FontAttributes="Bold" FontSize="16"/>
                    </Grid>
                    <Slider x:Name="LengthSlider" Minimum="1" Maximum="30" Value="15" HeightRequest="30" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="Transparent" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Uppercase" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" x:Name="UpperSwitch" IsToggled="True" Toggled="OnFilterToggled" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Lowercase" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" x:Name="LowerSwitch" IsToggled="True" Toggled="OnFilterToggled" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Numbers" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" x:Name="NumbersSwitch" IsToggled="True" Toggled="OnFilterToggled" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Symbols" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" x:Name="SymbolsSwitch" IsToggled="True" Toggled="OnSymbolsToggled" />
                    </Grid>

                    <VerticalStackLayout x:Name="SymbolsEditorLayout" Spacing="5" Margin="0,5,0,0">
                        <Grid ColumnDefinitions="*, Auto" HeightRequest="32">
                            <Label Grid.Column="0" Text="Edit Symbols:" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                            <ImageButton Grid.Column="1" 
                                x:Name="ResetSymbolsBtn"
                                Source="{AppThemeBinding Light=ic_reset_light.png, Dark=ic_reset_dark.png}"
                                IsVisible="False"
                                HeightRequest="32" WidthRequest="32" Padding="6" BackgroundColor="Transparent"
                                VerticalOptions="Center" Clicked="OnResetSymbolsClicked" />
                        </Grid>
                        <Entry x:Name="SymbolsEntry" 
                            Text="{x:Static constants:Constants.DefaultSymbols}" 
                            FontSize="16" 
                            TextChanged="OnSymbolsTextChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ExcludedEditorLayout" Spacing="5" Margin="0,5,0,0">
                        <Grid ColumnDefinitions="*, Auto" HeightRequest="32">
                            <Label Grid.Column="0" Text="Exclude Characters:" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                            <ImageButton Grid.Column="1" 
                                x:Name="AmbiguousBtn"
                                Source="{AppThemeBinding Light=ic_ambiguous_light.png, Dark=ic_ambiguous_dark.png}"
                                IsVisible="False"
                                WidthRequest="24" 
                                HeightRequest="24" 
                                Padding="2"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                Clicked="OnFillAmbiguousClicked" />
                        </Grid>
                        <Entry x:Name="ExcludedEntry" 
                            Placeholder="e.g. iIlL10O" 
                            FontSize="16" 
                            TextChanged="OnExcludedChanged" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="GenerateBtn" 
                Text="GENERATE PASSWORD" 
                FontAttributes="Bold" 
                HeightRequest="45"
                Clicked="OnGenerateClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>